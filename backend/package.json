{
  "name": "countries-explorer-backend",
  "version": "1.0.0",
  "description": "Backend API for Countries Explorer MERN app",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand",
    "seed": "node src/scripts/seedUser.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.4.1",
    "pdfkit": "0.15.0"
  },
  "devDependencies": {
    "fast-check": "3.19.0",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.0.0",
    "supertest": "7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/*.test.js"
    ]
  }
}
